# =================================================================
# LIVE DATABASE CONFIGURATION (Supabase, Neon, Cloud SQL, Local)
# =================================================================
# Option A: Single Connection URI (Recommended for Supabase & Neon)
# Example: postgresql://postgres.xxxx:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=""

# Option B: Discrete Parameters (Optional fallback)
SQL_HOST=""
SQL_PORT="5432"
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""
SQL_SSL="true"

# Set to "false" only if your local PostgreSQL does not use SSL
DB_SSL="true"

# =================================================================
# NOSQL DATABASE CONFIGURATION (MongoDB Atlas / Local MongoDB)
# =================================================================
# Connection URI for MongoDB Atlas Cluster or local MongoDB instance
# Example (MongoDB Atlas Free Tier):
# MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/alumni_portal?retryWrites=true&w=majority"
# Example (Local MongoDB):
# MONGODB_URI="mongodb://localhost:27017/alumni_connect"
MONGODB_URI=""

# Application Port
PORT="3000"


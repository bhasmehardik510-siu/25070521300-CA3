# =================================================================
# LIVE DATABASE CONFIGURATION (Supabase, Neon, Cloud SQL, Local)
# =================================================================
# Option A: Single Connection URI (Recommended for Supabase & Neon)
# Example: postgresql://postgres.xxxx:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=""

# Option B: Discrete Parameters (Optional fallback)
SQL_HOST=""
SQL_PORT="5432"
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""
SQL_SSL="true"

# Set to "false" only if your local PostgreSQL does not use SSL
DB_SSL="true"

# Application Port
PORT="3000"
